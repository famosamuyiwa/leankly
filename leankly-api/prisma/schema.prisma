generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appwriteUserId String    @unique @map("appwrite_user_id")
  email          String    @unique
  emailVerified  Boolean   @default(false) @map("email_verified")
  name           String
  avatarUrl      String?   @map("avatar_url")
  avatarFileId   String?   @map("avatar_file_id")
  age            Int?
  sex            String?
  location       String?
  locationLat    Float?    @map("location_lat")
  locationLng    Float?    @map("location_lng")
  pushTargetId   String?   @map("push_target_id")
  pushProviderId String?   @map("push_provider_id")
  pushPlatform   String?   @map("push_platform")
  pushEnabled    Boolean   @default(false) @map("push_enabled")
  role           UserRole  @default(USER)
  referralCode   String?   @unique @map("referral_code")
  referralCount  Int       @default(0) @map("referral_count")
  bonusInterests Int       @default(0) @map("bonus_interests")
  referredById   String?   @map("referred_by_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  suspendedAt    DateTime? @map("suspended_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([isActive, deletedAt])
  @@map("users")
}
