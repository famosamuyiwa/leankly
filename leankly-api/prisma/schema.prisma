generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UsageFeature {
  INTEREST
  UNDO
}

enum LeankStatus {
  ACTIVE    @map("Active")
  COMPLETED @map("Completed")
  CANCELED  @map("Canceled")
}

enum LeankCategory {
  FITNESS      @map("Fitness & Sports")
  STUDY        @map("Study & Learning")
  SOCIAL       @map("Social & Nightlife")
  VOLUNTEERING @map("Volunteering & Causes")
  HEALTH       @map("Health & Wellness")
  CREATIVE     @map("Creative & Arts")
  FOOD         @map("Food & Drinks")
  TRAVEL       @map("Travel & Outdoors")
  CAREER       @map("Career & Networking")
  GAMING       @map("Gaming & Esports")
  OTHER        @map("Other")
}

enum ReactionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MessageType {
  USER
  SYSTEM
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appwriteUserId String    @unique @map("appwrite_user_id")
  email          String    @unique
  emailVerified  Boolean   @default(false) @map("email_verified")
  name           String
  avatarUrl      String?   @map("avatar_url")
  avatarFileId   String?   @map("avatar_file_id")
  age            Int?
  sex            String?
  location       String?
  locationLat    Float?    @map("location_lat")
  locationLng    Float?    @map("location_lng")
  pushTargetId   String?   @map("push_target_id")
  pushProviderId String?   @map("push_provider_id")
  pushPlatform   String?   @map("push_platform")
  pushEnabled    Boolean   @default(false) @map("push_enabled")
  role           UserRole  @default(USER)
  referralCode   String?   @unique @map("referral_code")
  referralCount  Int       @default(0) @map("referral_count")
  bonusInterests Int       @default(0) @map("bonus_interests")
  referredById   String?   @map("referred_by_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  suspendedAt    DateTime? @map("suspended_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  blocksCreated    Block[]          @relation("Blocker")
  blocksReceived   Block[]          @relation("Blocked")
  reportsCreated   Report[]         @relation("Reporter")
  reportsReceived  Report[]         @relation("Reported")
  referralsCreated Referral[]       @relation("Referrer")
  referralReceived Referral?        @relation("Referred")
  referredBy       User?            @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers    User[]           @relation("UserReferrals")
  dailyUsage       DailyUsage[]
  entitlement      UserEntitlement?
  ownedLeanks      Leank[]          @relation("LeankOwner")
  participations   Participant[]
  reactions        Reaction[]
  messages         Message[]
  chatMetadata     UserChatMeta[]

  @@index([isActive, deletedAt])
  @@map("users")
}

model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  reportedId String   @map("reported_id") @db.Uuid
  reason     String
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model Referral {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId String   @map("referrer_id") @db.Uuid
  referredId String   @unique @map("referred_id") @db.Uuid
  code       String
  createdAt  DateTime @default(now()) @map("created_at")

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@map("referrals")
}

model DailyUsage {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  feature   UsageFeature
  usageDate DateTime     @map("usage_date") @db.Date
  count     Int          @default(0)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, usageDate])
  @@map("daily_usage")
}

model UserEntitlement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  isPro       Boolean   @default(false) @map("is_pro")
  expiresAt   DateTime? @map("expires_at")
  lastEventAt DateTime? @map("last_event_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_entitlements")
}

model RevenueCatWebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  appUserId   String?  @map("app_user_id")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([appUserId, processedAt])
  @@map("revenuecat_webhook_events")
}

model Leank {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  title          String
  description    String        @default("")
  coverUrl       String        @map("cover_url")
  coverFileId    String?       @map("cover_file_id")
  status         LeankStatus   @default(ACTIVE)
  category       LeankCategory @default(OTHER)
  eventDate      DateTime      @map("event_date") @db.Date
  time           String        @default("")
  location       String
  locationLat    Float?        @map("location_lat")
  locationLng    Float?        @map("location_lng")
  isOnline       Boolean       @default(false) @map("is_online")
  peopleRequired Int           @default(1) @map("people_required")
  lastMessageId  String?       @map("last_message_id") @db.Uuid
  lastMessageAt  DateTime?     @map("last_message_at")
  lastActivityAt DateTime      @default(now()) @map("last_activity_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  owner        User           @relation("LeankOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants Participant[]
  reactions    Reaction[]
  messages     Message[]      @relation("LeankMessages")
  lastMessage  Message?       @relation("LastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  chatMetadata UserChatMeta[]

  @@index([status, createdAt, id])
  @@index([ownerId, createdAt, id])
  @@index([status, lastActivityAt, id])
  @@index([ownerId, lastActivityAt, id])
  @@index([eventDate, status])
  @@index([category, status])
  @@index([locationLat, locationLng])
  @@map("leanks")
}

model Participant {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leankId  String   @map("leank_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")

  leank Leank @relation(fields: [leankId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leankId, userId])
  @@index([userId, joinedAt])
  @@index([userId, leankId])
  @@map("participants")
}

model Reaction {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  leankId   String         @map("leank_id") @db.Uuid
  isLiked   Boolean        @map("is_liked")
  status    ReactionStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  leank Leank @relation(fields: [leankId], references: [id], onDelete: Cascade)

  @@unique([userId, leankId])
  @@index([leankId, isLiked, status, createdAt])
  @@index([status, isLiked, createdAt, id])
  @@map("reactions")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leankId        String      @map("leank_id") @db.Uuid
  senderId       String?     @map("sender_id") @db.Uuid
  senderName     String      @map("sender_name")
  senderPhoto    String?     @map("sender_photo")
  content        String
  type           MessageType @default(USER)
  replyToId      String?     @map("reply_to_id") @db.Uuid
  replyToContent String?     @map("reply_to_content")
  replyToSender  String?     @map("reply_to_sender")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  leank          Leank     @relation("LeankMessages", fields: [leankId], references: [id], onDelete: Cascade)
  sender         User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  replyTo        Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[] @relation("MessageReplies")
  lastMessageFor Leank[]   @relation("LastMessage")

  @@index([leankId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model UserChatMeta {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leankId   String    @map("leank_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  leank Leank @relation(fields: [leankId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leankId, userId])
  @@index([userId, readAt])
  @@map("user_chat_meta")
}
